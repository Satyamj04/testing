# =============================================================================
# VAPT Agent - Environment Configuration Example
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-64-chars
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vaptdb
POSTGRES_USER=vaptuser
POSTGRES_PASSWORD=vaptpass
DATABASE_URL=postgresql+asyncpg://vaptuser:vaptpass@postgres:5432/vaptdb
DATABASE_URL_SYNC=postgresql://vaptuser:vaptpass@postgres:5432/vaptdb

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO / S3 Object Storage ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_EVIDENCE=vapt-evidence
MINIO_BUCKET_REPORTS=vapt-reports
MINIO_USE_SSL=false

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM ---
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=...

# --- Proxy ---
MITM_PORT=8080
MITM_UPSTREAM_PORT=8081

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OWASP ZAP ---
ZAP_API_KEY=zap-api-key-here
ZAP_HOST=zap
ZAP_PORT=8090

# --- Nuclei ---
NUCLEI_TEMPLATES_PATH=/app/nuclei-templates

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
